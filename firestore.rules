rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Pengaturan Aplikasi & Syarat Usulan (admin checklist requirements)
    match /appConfig/{docId} {
      allow read, write: if isSignedIn();
    }

    // Konfigurasi Bidang (Spreadsheet ID, Folder Drive URL, Pagu Indikatif)
    match /bidangConfigs/{docId} {
      allow read, write: if isSignedIn();
    }

    // Catch-all default deny for any other unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
